{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "vitest.tour.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/i18n/ru.ts",
    "src/renderer/src/i18n/en.ts",
    "src/renderer/src/app/saved-state.ts",
    "src/renderer/src/features/forms/form-values.ts",
    "src/renderer/src/features/protect/protect-form.ts",
    "src/renderer/src/app/window-title.ts",
    "src/renderer/src/pdf-engine/outline.ts",
    "src/renderer/src/features/viewer/zoom.ts",
    "src/renderer/src/features/settings/parse-markdown.ts",
    "tests/unit/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/tour/**/*.ts"
  ]
}
