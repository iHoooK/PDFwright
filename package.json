{
  "name": "pdfwright",
  "productName": "PDFwright",
  "version": "0.1.0",
  "description": "PDFwright: local Windows app to view, edit and process PDF files.",
  "author": {
    "name": "Promptix",
    "url": "https://promptix.ru/"
  },
  "homepage": "https://github.com/iHoooK/PDFwright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iHoooK/PDFwright.git"
  },
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "icons": "electron scripts/build-icons.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/react-icons": "^2.0.344",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
